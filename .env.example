# ─────────────────────────────────────────────────────────────────────────────
# Growthify OS — environment variables
# Copy to .env.local for local development. On Vercel, add each one under
# Project → Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (no trailing slash). Used for OAuth redirects and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Google emails that become Owner on first sign-in.
OWNER_EMAILS=bymegrowthify@gmail.com

# 32 random bytes, base64. Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client (YouTube connection — separate from app login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/callback

# Meta developer app (Facebook Page + Instagram, option B "Connect with Facebook")
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback
META_GRAPH_VERSION=v26.0

# Threads API (same Meta app, Threads use case)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/integrations/threads/callback

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET=

# Shows Settings → "Load demo data". Keep false in production.
ALLOW_DEMO_DATA=false
